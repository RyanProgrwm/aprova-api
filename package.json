{
  "name": "aprova-api",
  "version": "1.0.0",
  "description": "api rest de pedidos de compra com fluxo de aprovação em níveis por faixa de valor",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test"
  },
  "keywords": [
    "node",
    "express",
    "rest",
    "jwt",
    "sqlite",
    "workflow",
    "approval"
  ],
  "author": "Ryan Rodrigues Saldanha Faria",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
